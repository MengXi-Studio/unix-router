{
	"name": "unix-router",
	"type": "module",
	"version": "0.1.0",
	"private": false,
	"description": "为 uni-app x 提供类似 vue-router 风格的路由库",
	"packageManager": "pnpm@10.31.0",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev:playground:h5": "pnpm --filter @meng-xi/unix-router-playground dev:h5",
		"dev:playground:mp-weixin": "pnpm --filter @meng-xi/unix-router-playground dev:mp-weixin",
		"build:playground:h5": "pnpm --filter @meng-xi/unix-router-playground build:h5",
		"build:playground:mp-weixin": "pnpm --filter @meng-xi/unix-router-playground build:mp-weixin",
		"release": "bumpp",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint .",
		"lint:fix": "pnpm lint --fix",
		"clean": "rimraf --glob node_modules pnpm-lock.yaml packages/**/node_modules packages/**/pnpm-lock.yaml"
	},
	"devDependencies": {
		"@eslint/js": "^9.38.0",
		"bumpp": "^12.3.0",
		"eslint": "^9.38.0",
		"eslint-config-prettier": "^10.1.0",
		"eslint-plugin-prettier": "^5.5.0",
		"globals": "^16.2.0",
		"prettier": "^3.8.1",
		"rimraf": "^6.1.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0"
	},
	"author": {
		"name": "PedroQue99",
		"email": "ksmengfang@163.com"
	},
	"license": "MIT",
	"homepage": "https://github.com/MengXi-Studio/unix-router#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MengXi-Studio/unix-router.git"
	},
	"bugs": "https://github.com/MengXi-Studio/unix-router/issues"
}
