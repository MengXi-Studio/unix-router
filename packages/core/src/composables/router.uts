/**
 * useRouter 组合式 API
 *
 * 在组件 setup 中获取路由器实例。优先通过 provide/inject 获取，
 * 未注入时回退到全局活跃路由器。
 */
import { inject } from 'vue'
import type { Router } from '../types'
import { ROUTER_SYMBOL } from '../constants'
import { activeGlobalRouter } from '../store'

/**
 * 获取路由器实例
 * @throws 当既未注入也未被全局安装时抛出
 */
export function useRouter(): Router {
	const injected = inject<Router>(ROUTER_SYMBOL, null)
	if (injected) {
		return injected
	}
	const global = activeGlobalRouter()
	if (global) {
		return global
	}
	throw new Error('未找到路由器实例，请稍 app.use(router) 并确保在组件 setup 或含 provide 上下文中调用 useRouter()')
}