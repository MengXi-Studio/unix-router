/**
 * 路由匹配器实现
 *
 * 基于 path / name 双索引，将字符串路径、路径对象、命名对象解析为完整 RouteLocation。
 * 采用扁平页面模型（uni-app x），不支持嵌套/动态路由。
 *
 * params 适配：对象位置的对象参数直接挂到 RouteLocation.params；由路由器在拼 URL 时
 * 通过 encodeParamsToQuery 编码进查询，字符串路径解析时据保留前缀重建 params。
 */
import type { RouteConfig, RouteLocation, RouteLocationNamedRaw, RouteLocationPathRaw, RouteLocationRaw, RouteMeta } from '../types'
import { RouterErrorCode } from '../enums'
import { RouterError } from '../errors/router-error'
import { buildFullPath, normalizePath, parseQuery, isObject, warn, extractParamsFromQuery } from '../utils'
import type { RouteMatcher } from './type'

export type { RouteMatcher } from './type'

/** 解析后的「路径 + 查询」结果（具名类型，规避内联对象类型声明） */
type ParsedPathUrl = {
	path: string
	query: Map<string, string>
}

/**
 * 创建路由匹配器
 * @param routes - 路由配置列表
 * @param strict - 是否严格模式（未匹配的命名路由抛错）
 * @returns 路由匹配器实例
 */
export function createRouteMatcher(routes: RouteConfig[], strict: boolean): RouteMatcher {
	const pathMap: Map<string, RouteConfig> = new Map()
	const nameMap: Map<string, RouteConfig> = new Map()
	const routeList: RouteConfig[] = []

	for (var i = 0; i < routes.length; i++) {
		const route = routes[i]
		const normalizedPath = normalizePath(route.path)
		const rname: string | null = route.name != null && route.name.length > 0 ? route.name : null
		if (rname !== null && nameMap.has(rname)) {
			warn(`检测到重复路由名称 "${rname}"，后者将覆盖前者。`)
		}
		if (pathMap.has(normalizedPath)) {
			warn(`检测到重复路由路径 "${normalizedPath}"，后者将覆盖前者。`)
		}
		pathMap.set(normalizedPath, route)
		if (rname !== null) {
			nameMap.set(rname, route)
		}
		routeList.push(route)
	}

	function getRoutes(): RouteConfig[] {
		return [...routeList]
	}

	function hasRoute(name: string): boolean {
		return nameMap.has(name)
	}

	function getRouteConfig(path: string): RouteConfig | null {
		const config = pathMap.get(normalizePath(path))
		return config === undefined ? null : config
	}

	/** 构造 RouteLocation */
	function createLocation(path: string, name: string | null, meta: RouteMeta, query: Map<string, string>, params: Map<string, string>): RouteLocation {
		return {
			path,
			name,
			meta,
			query,
			params,
			fullPath: buildFullPath(path, query),
			hash: '',
			matched: []
		}
	}

	function resolveFromPathString(path: string): RouteLocation {
		const parsed = parsePathUrl(path)
		const config = pathMap.get(normalizePath(parsed.path))
		const meta: RouteMeta = config != null && config.meta != null ? config.meta : {}
		const params = extractParamsFromQuery(parsed.query)
		const location = createLocation(normalizePath(parsed.path), config != null ? (config.name != null ? config.name : null) : null, meta, parsed.query, params)
		location.matched = config != null ? [config] : []
		return location
	}

	function resolveFromPathRaw(location: RouteLocationPathRaw): RouteLocation {
		const query: Map<string, string> = location.query != null ? new Map(location.query) : new Map()
		const params: Map<string, string> = location.params != null ? new Map(location.params) : new Map()
		const config = pathMap.get(normalizePath(location.path))
		const meta: RouteMeta = config != null && config.meta != null ? config.meta : {}
		const loc = createLocation(normalizePath(location.path), config != null ? (config.name != null ? config.name : null) : null, meta, query, params)
		loc.matched = config != null ? [config] : []
		return loc
	}

	function resolveFromName(location: RouteLocationNamedRaw): RouteLocation {
		const config = nameMap.get(location.name)
		if (config === null) {
			if (strict) {
				throw new RouterError(RouterErrorCode.ROUTE_NOT_FOUND, `未找到命名路由 "${location.name}"。`, emptyLocation(''), emptyLocation(''))
			}
			warn(`未找到命名路由 "${location.name}"，将按路径处理。`)
			const query: Map<string, string> = location.query != null ? new Map(location.query) : new Map()
			const params: Map<string, string> = location.params != null ? new Map(location.params) : new Map()
			const loc = createLocation(`/${location.name}`, null, {}, query, params)
			loc.matched = []
			return loc
		}
		const query: Map<string, string> = location.query != null ? new Map(location.query) : new Map()
		const params: Map<string, string> = location.params != null ? new Map(location.params) : new Map()
		const meta: RouteMeta = config.meta != null ? config.meta : {}
		const loc = createLocation(normalizePath(config.path), config.name != null ? config.name : null, meta, query, params)
		loc.matched = [config]
		return loc
	}

	/** 解析原始位置 */
	function resolve(location: RouteLocationRaw): RouteLocation {
		if (typeof location === 'string') {
			return resolveFromPathString(location)
		}
		if (isObject(location)) {
			const named = location as RouteLocationNamedRaw
			if (named.name != null && named.name.length > 0) {
				return resolveFromName(named)
			}
			const pathRaw = location as RouteLocationPathRaw
			if (pathRaw.path != null && pathRaw.path.length > 0) {
				return resolveFromPathRaw(pathRaw)
			}
		}
		throw new RouterError(RouterErrorCode.ROUTE_NOT_FOUND, `非法的路由位置: ${JSON.stringify(location)}。`, emptyLocation(''), emptyLocation(''))
	}

	return {
		getRoutes,
		hasRoute,
		resolve,
		getRouteConfig
	}
}

/** 解析完整 URL 字符串为路径 + 查询（内部工具） */
function parsePathUrl(full: string): ParsedPathUrl {
	const qIndex = full.indexOf('?')
	if (qIndex === -1) {
		return { path: full, query: new Map() }
	}
	return { path: full.substring(0, qIndex), query: parseQuery(full.substring(qIndex + 1)) }
}

/** 构造空 RouteLocation（供错误场景占位） */
function emptyLocation(path: string): RouteLocation {
	return {
		path: normalizePath(path),
		meta: {},
		name: null,
		query: new Map(),
		params: new Map(),
		fullPath: normalizePath(path),
		hash: '',
		matched: []
	}
}