/**
 * 查询参数增强读取工具
 * 提供 queryInt / queryNumber / queryBool 等从查询 Map 原子读值的能力
 */
import { PARAMS_QUERY_PREFIX } from '../constants'

/**
 * 从查询 Map 读取整型值
 * @param query - 查询键值 Map
 * @param key - 键名
 * @param defaultValue - 解析失败时的默认值
 * @returns 整型值
 */
export function queryInt(query: Map<string, string>, key: string, defaultValue: number = 0): number {
	const raw = query.get(key)
	if (raw === null || raw === undefined || raw === '') {
		return defaultValue
	}
	const n = Number.parseInt(raw, 10)
	if (isNaN(n)) {
		return defaultValue
	}
	return n
}

/**
 * 从查询 Map 读取数值
 * @param query - 查询键值 Map
 * @param key - 键名
 * @param defaultValue - 解析失败时的默认值
 * @returns 数值
 */
export function queryNumber(query: Map<string, string>, key: string, defaultValue: number = 0): number {
	const raw = query.get(key)
	if (raw === null || raw === undefined || raw === '') {
		return defaultValue
	}
	const n = Number.parseFloat(raw)
	if (isNaN(n)) {
		return defaultValue
	}
	return n
}

/**
 * 从查询 Map 读取布尔值（'' / '0' / 'false' 视为 false）
 * @param query - 查询键值 Map
 * @param key - 键名
 * @param defaultValue - 解析失败时的默认值
 * @returns 布尔值
 */
export function queryBool(query: Map<string, string>, key: string, defaultValue: boolean = false): boolean {
	const raw = query.get(key)
	if (raw === null || raw === undefined || raw === '') {
		return defaultValue
	}
	return raw !== '0' && raw !== 'false'
}

/**
 * 将 params 编码进查询 Map（使用保留前缀），返回扩展后的查询 Map
 * 用于导航 URL 传递对象化的路由参数（uni-app x 静态模型适配）
 * @param query - 原查询 Map
 * @param params - 路由参数 Map
 * @returns 扩展后的查询 Map
 */
export function encodeParamsToQuery(query: Map<string, string>, params: Map<string, string>): Map<string, string> {
	const result = new Map<string, string>(query)
	params.forEach((value, key) => {
		result.set(PARAMS_QUERY_PREFIX + encodeURIComponent(key), value)
	})
	return result
}

/**
 * 从查询 Map 提取 params（按保留前缀），并从原查询中移除这些内部 key
 * @param query - 查询 Map（会被就地剔除 params 相关 key）
 * @returns 提取出的 params Map
 */
export function extractParamsFromQuery(query: Map<string, string>): Map<string, string> {
	const params = new Map<string, string>()
	const removeKeys: string[] = []
	query.forEach((value, key) => {
		if (key.startsWith(PARAMS_QUERY_PREFIX)) {
			const realKey = decodeURIComponent(key.substring(PARAMS_QUERY_PREFIX.length))
			params.set(realKey, value)
			removeKeys.push(key)
		}
	})
	for (var i = 0; i < removeKeys.length; i++) {
		query.delete(removeKeys[i])
	}
	return params
}