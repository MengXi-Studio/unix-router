/**
 * 路由器主类与 createRouter
 *
 * 提供 vue-router 风格的导航、守卫注册与状态查询能力，适配 uni-app x 静态页面模型。
 * 底层基于 uni.* 原生导航 API 与原生页面栈（getCurrentPages）实现。
 */
import type { App } from 'vue'
import type { GuardRouteOptions, NavigationResult, PostNavigationGuard, RouteConfig, RouteLocation, RouteLocationRaw, NavigationGuard, Router, RouterOnError, RouterOptions } from '../types'
import { RouterErrorCode } from '../enums'
import { ROUTER_SYMBOL, DEFAULT_GUARD_TIMEOUT, DEFAULT_READY_TIMEOUT, DEFAULT_NAV_VERIFY_TIMEOUT, MAX_REDIRECT_DEPTH } from '../constants'
import { NavigationFailure, RouterError } from '../errors'
import { createGuardManager, type GuardManager, type GuardResult } from '../guard'
import { navigateTo, replaceTo, relaunchTo, goBack } from '../navigation'
import type { UniNavigationOptions } from '../navigation/type'
import { getCurrentPagesSafe, getPageStackLength, waitForTopPage } from '../navigation/context'
import { createRouteState, type RouteState } from '../state'
import { createRouteMatcher, type RouteMatcher } from '../matcher'
import { UniHistory } from '../history'
import { encodeParamsToQuery, normalizePath, warn } from '../utils'
import { setActiveGlobalRouter, setGlobalCurrentRoute } from '../store'
import { isSameRouteLocation } from './location'
import type { NavigationMode } from './type'

/**
 * uni-app x 路由器实现类
 */
class UniRouter implements Router {
	private routeState: RouteState
	private guardManager: GuardManager
	private matcher: RouteMatcher
	private history: UniHistory
	private pendingNavigation: Promise<NavigationResult> | null = null
	private errorHandlers: RouterOnError[] = []
	private guardTimeout: number
	private readyTimeout: number
	private strict: boolean

	constructor(options: RouterOptions) {
		this.strict = options.strict !== undefined ? options.strict : true
		this.guardTimeout = options.guardTimeout !== undefined ? options.guardTimeout : DEFAULT_GUARD_TIMEOUT
		this.readyTimeout = options.readyTimeout !== undefined ? options.readyTimeout : DEFAULT_READY_TIMEOUT
		this.guardManager = createGuardManager()
		this.matcher = createRouteMatcher(options.routes, this.strict)
		this.routeState = createRouteState(this.readyTimeout)
		this.history = new UniHistory(this.matcher)
		this.pendingNavigation = null
		this.errorHandlers = []
		this.initRoute()
	}

	/** 当前路由位置 */
	get currentRoute(): RouteLocation {
		return this.routeState.currentRoute.value
	}

	/** 导航到新页面（uni.navigateTo / uni.switchTab） */
	push(location: RouteLocationRaw): Promise<NavigationResult> {
		return this.performNavigation(location, 'push')
	}

	/** 替换当前页面（uni.redirectTo / uni.switchTab） */
	replace(location: RouteLocationRaw): Promise<NavigationResult> {
		return this.performNavigation(location, 'replace')
	}

	/** 关闭所有页面并打开目标页面（uni.reLaunch / uni.switchTab） */
	relaunch(location: RouteLocationRaw): Promise<NavigationResult> {
		return this.performNavigation(location, 'relaunch')
	}

	/** 返回上一页或多级页面（uni.navigateBack） */
	async back(delta: number = 1): Promise<NavigationResult> {
		if (this.pendingNavigation) {
			await this.pendingNavigation.catch(() => {})
		}
		const from = this.routeState.currentRoute.value
		if (delta <= 0 || !Number.isInteger(delta)) {
			return this.failNavigation(from, from, new NavigationFailure(RouterErrorCode.ABORTED, 'back() 的 delta 必须为正整数', from, from))
		}
		const pages = getCurrentPagesSafe()
		if (pages.length < 2 || delta >= pages.length) {
			return this.failNavigation(from, from, new NavigationFailure(RouterErrorCode.CANCELLED, '无法返回：页面栈中没有足够的上一页', from, from))
		}
		const targetPage = pages[pages.length - 1 - delta]
		const targetPath = '/' + targetPage.route
		const to = this.matcher.resolve(targetPath)

		const before = await this.guardManager.runBeforeEach(to, from, this.guardTimeout)
		const handled = await this.handleGuardResult(before, to, from, 'push')
		if (handled) return handled

		const resolveResult = await this.guardManager.runBeforeResolve(to, from, this.guardTimeout)
		const handledResolve = await this.handleGuardResult(resolveResult, to, from, 'push')
		if (handledResolve) return handledResolve

		try {
			await goBack(delta)
			this.routeState.setCurrentRoute(to)
			this.guardManager.runAfter(to, from)
			return to
		} catch (e) {
			const failure = new NavigationFailure(RouterErrorCode.NAVIGATION_API_ERROR, `返回失败: ${e}`, to, from)
			return this.failNavigation(to, from, failure)
		}
	}

	beforeEach(guard: NavigationGuard): () => void {
		return this.guardManager.beforeEach(guard)
	}

	beforeResolve(guard: NavigationGuard): () => void {
		return this.guardManager.beforeResolve(guard)
	}

	afterEach(guard: PostNavigationGuard): () => void {
		return this.guardManager.afterEach(guard)
	}

	getRoutes(): RouteConfig[] {
		return this.matcher.getRoutes()
	}

	hasRoute(name: string): boolean {
		return this.matcher.hasRoute(name)
	}

	resolve(location: RouteLocationRaw): RouteLocation {
		return this.matcher.resolve(location)
	}

	isReady(): Promise<void> {
		return this.routeState.onReady()
	}

	onError(handler: RouterOnError): () => void {
		this.errorHandlers.push(handler)
		return () => {
			const index = this.errorHandlers.indexOf(handler)
			if (index > -1) {
				this.errorHandlers.splice(index, 1)
			}
		}
	}

	onRouteChange(listener: (to: RouteLocation, from: RouteLocation) => void): () => void {
		return this.routeState.onRouteChange(listener)
	}

	/** 从页面栈同步路由状态到 currentRoute */
	syncRoute(): void {
		try {
			const current = this.history.resolveCurrent()
			this.routeState.setCurrentRoute(current)
		} catch (e) {
			warn(`路由状态同步失败: ${e}`)
		}
	}

	/** 对指定路由补执行守卫链（冷启动），不执行实际导航 */
	async guardRoute(location?: RouteLocationRaw, options?: GuardRouteOptions): Promise<RouteLocation> {
		const target = location ? this.matcher.resolve(location) : this.routeState.currentRoute.value
		const from = this.routeState.currentRoute.value
		const before = await this.guardManager.runBeforeEach(target, from, this.guardTimeout)
		if (before.kind === 'abort') {
			const failure = new NavigationFailure(before.code ?? RouterErrorCode.CANCELLED, '守卫中止了冷启动导航', target, from)
			this.triggerErrorHandlers(failure, target, from)
			if (options && options.onAbort) {
				options.onAbort(failure)
			}
			return Promise.reject(failure)
		}
		if (before.kind === 'redirect' && before.redirect) {
			const redirectMode = before.mode ?? 'relaunch'
			return this.performNavigation(before.redirect, redirectMode === 'replace' ? 'replace' : redirectMode === 'push' ? 'push' : 'relaunch')
		}
		return target
	}

	/** 安装路由器到 Vue 应用 */
	install(app: App): void {
		app.provide(ROUTER_SYMBOL, this)
		if (!('$router' in app.config.globalProperties)) {
			app.config.globalProperties.$router = this
		}
		if (!('$route' in app.config.globalProperties)) {
			Object.defineProperty(app.config.globalProperties, '$route', {
				enumerable: true,
				configurable: true,
				get: () => this.routeState.currentRoute.value
			})
		}
		const router = this
		app.mixin({
			onShow() {
				router.syncRoute()
			}
		})
		this.routeState.markReady()
	}

	/** 冷启动时按页面栈初始化当前路由状态 */
	private initRoute(): void {
		if (getPageStackLength() === 0) {
			// 页面栈为空：以 '/' 占位
			return
		}
		this.syncRoute()
	}

	/** 构造 uni 导航选项（将 params 编码进 query） */
	private buildNavOptions(to: RouteLocation): UniNavigationOptions {
		const query = encodeParamsToQuery(to.query, to.params)
		return {
			path: to.path,
			query,
			isTab: !!(to.meta && to.meta.isTab),
			meta: to.meta
		}
	}

	/** 执行导航（带并发排队与重复导航检测） */
	private async performNavigation(location: RouteLocationRaw, mode: NavigationMode): Promise<NavigationResult> {
		if (this.pendingNavigation) {
			await this.pendingNavigation.catch(() => {})
		}
		let to: RouteLocation
		try {
			to = this.matcher.resolve(location)
		} catch (e) {
			const from = this.routeState.currentRoute.value
			if (e instanceof RouterError) {
				return this.failNavigation(from, from, e)
			}
			const failure = new NavigationFailure(RouterErrorCode.ROUTE_NOT_FOUND, `路由解析失败: ${e}`, from, from)
			return this.failNavigation(from, from, failure)
		}
		const from = this.routeState.currentRoute.value
		// 重复导航检测（push 到同一地址）
		if (mode === 'push' && isSameRouteLocation(to, from)) {
			const failure = new NavigationFailure(RouterErrorCode.DUPLICATED, `避免重复导航到当前地址: "${to.fullPath}"`, to, from)
			return this.failNavigation(to, from, failure)
		}

		const promise = this.executeNavigation(to, from, mode, 0)
		this.pendingNavigation = promise
		try {
			return await promise
		} finally {
			if (this.pendingNavigation === promise) {
				this.pendingNavigation = null
			}
		}
	}

	/** 执行完整导航流程：beforeEach → beforeEnter → beforeResolve → uni API → afterEach */
	private async executeNavigation(to: RouteLocation, from: RouteLocation, mode: NavigationMode, redirectDepth: number): Promise<NavigationResult> {
		if (redirectDepth > MAX_REDIRECT_DEPTH) {
			const failure = new NavigationFailure(RouterErrorCode.CANCELLED, `重定向深度超过上限(${MAX_REDIRECT_DEPTH})`, to, from)
			return this.failNavigation(to, from, failure)
		}

		const config = this.matcher.getRouteConfig(to.path)

		const before = await this.guardManager.runBeforeEach(to, from, this.guardTimeout)
		const handled = await this.handleGuardResult(before, to, from, mode, redirectDepth)
		if (handled) return handled

		if (config) {
			const beforeEnter = await this.guardManager.runBeforeEnter(config, to, from, this.guardTimeout)
			const handledEnter = await this.handleGuardResult(beforeEnter, to, from, mode, redirectDepth)
			if (handledEnter) return handledEnter
		}

		const beforeResolve = await this.guardManager.runBeforeResolve(to, from, this.guardTimeout)
		const handledResolve = await this.handleGuardResult(beforeResolve, to, from, mode, redirectDepth)
		if (handledResolve) return handledResolve

		try {
			const navOptions = this.buildNavOptions(to)
			if (mode === 'push') {
				await navigateTo(navOptions)
			} else if (mode === 'replace') {
				await replaceTo(navOptions)
			} else {
				await relaunchTo(navOptions)
			}
			// uni api 受理不代表目标页已入栈，确认目标页真实成为栈顶后才视为成功
			const confirmed = await this.confirmNavigation(to)
			if (!confirmed) {
				const failure = new NavigationFailure(RouterErrorCode.NAVIGATION_API_ERROR, `导航后未能在页面栈顶确认目标页: "${to.path}"`, to, from)
				return this.failNavigation(to, from, failure)
			}
			// 导航成功：更新状态并触发后置守卫
			this.routeState.setCurrentRoute(to)
			setGlobalCurrentRoute(to)
			this.guardManager.runAfter(to, from)
			return to
		} catch (e) {
			const failure = new NavigationFailure(RouterErrorCode.NAVIGATION_API_ERROR, `uni 导航失败: ${e}`, to, from)
			return this.failNavigation(to, from, failure)
		}
	}

	/**
	 * 轮询确认导航目标已进入页面栈顶
	 * 以页面栈（getCurrentPages）为唯一真实来源，避免 `uni` 导航单一 success 回调带来的状态漂移
	 */
	private confirmNavigation(to: RouteLocation): Promise<boolean> {
		return waitForTopPage(normalizePath(to.path), DEFAULT_NAV_VERIFY_TIMEOUT)
	}

	/**
	 * 处理守卫结果：abort → 失败；redirect → 递归导航；next → 返回 null 继续
	 */
	private async handleGuardResult(result: GuardResult, to: RouteLocation, from: RouteLocation, mode: NavigationMode, redirectDepth: number = 0): Promise<NavigationResult | null> {
		if (result.kind === 'abort') {
			const message = result.code === RouterErrorCode.CANCELLED && result.error ? `导航取消: ${result.error.message}` : '导航被中止'
			const failure = new NavigationFailure(result.code ?? RouterErrorCode.CANCELLED, message, to, from)
			return this.failNavigation(to, from, failure)
		}
		if (result.kind === 'redirect' && result.redirect) {
			const redirectMode: NavigationMode = result.mode === 'replace' ? 'replace' : result.mode === 'push' ? 'push' : mode
			const redirectTarget = this.matcher.resolve(result.redirect)
			return this.executeNavigation(redirectTarget, from, redirectMode, redirectDepth + 1)
		}
		return null
	}

	/** 触发所有错误处理器 */
	private triggerErrorHandlers(error: Error, to: RouteLocation, from: RouteLocation): void {
		for (var i = 0; i < this.errorHandlers.length; i++) {
			try {
				this.errorHandlers[i](error, to, from)
			} catch (e) {
				void e
			}
		}
	}

	/** 统一导航失败处理：触发 afterEach + 错误处理器，返回 reject */
	private failNavigation(to: RouteLocation, from: RouteLocation, failure: Error): Promise<never> {
		this.guardManager.runAfter(to, from, failure)
		this.triggerErrorHandlers(failure, to, from)
		return Promise.reject(failure)
	}
}

/**
 * 创建 uni-app x 路由器实例
 * @param options - 路由器初始化选项
 * @returns 路由器实例
 *
 * @example
 * ```uts
 * import { createRouter } from '@meng-xi/unix-router'
 *
 * const router = createRouter({
 *   routes: [
 *     { path: 'pages/index/index', name: 'home', meta: { title: '首页', isTab: true } },
 *     { path: 'pages/about/about', name: 'about', meta: { requireAuth: true } }
 *   ]
 * })
 * app.use(router)
 * await router.push('/pages/about/about')
 * ```
 */
export function createRouter(options: RouterOptions): Router {
	return new UniRouter(options)
}