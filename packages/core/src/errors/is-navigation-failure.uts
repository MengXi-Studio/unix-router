/**
 * isNavigationFailure：判断错误是否为指定类型的导航失败
 */
import { RouterErrorCode } from '../enums'
import { NavigationFailure } from './navigation-failure'

/**
 * 判断某个错误是否为指定类型/错误码的导航失败
 * @param error - 待判断的错误对象
 * @param type - 可选错误码；不传则只要是 NavigationFailure 即返回 true
 * @returns 是否为匹配的导航失败
 */
export function isNavigationFailure(error: Error | null | undefined, type?: RouterErrorCode): boolean {
	if (!(error instanceof NavigationFailure)) {
		return false
	}
	if (type !== undefined) {
		return (error as NavigationFailure).code === type
	}
	return true
}