/**
 * @meng-xi/unix-router 公共入口
 *
 * 为 uni-app x 提供 vue-router 风格的路由能力（UTS 源分发）。
 * 卖方按平台编译：web/小程序 → JS，Android → Kotlin，iOS → Swift。
 */
export { createRouter } from './router'
export { useRouter, useRoute, useLink, onBeforeRouteLeave, onBeforeRouteEnter, onBeforeRouteUpdate } from './composables'

export { RouterError, NavigationFailure, isNavigationFailure } from './errors'
export type { UniNavigationApiError } from './errors'

export { RouterErrorCode } from './enums'
export { ROUTER_SYMBOL, DEFAULT_GUARD_TIMEOUT, DEFAULT_READY_TIMEOUT, MAX_REDIRECT_DEPTH } from './constants'

/* 核心类型 */
export type {
	Router,
	RouterOptions,
	RouterOnError,
	GuardRouteOptions,
	RouteConfig,
	RouteLocation,
	RouteLocationRaw,
	RouteLocationNamedRaw,
	RouteLocationPathRaw,
	RawLocation,
	RouteMeta,
	RouteName,
	RoutePath,
	RouteNameMap,
	QueryValue,
	ParamObject,
	NavigationResult,
	NavigationRedirect,
	NavigationRedirectMode,
	NavigationGuard,
	NavigationGuardReturn,
	PostNavigationGuard,
	BeforeRouteEnterGuard,
	BeforeRouteUpdateGuard,
	BeforeRouteLeaveGuard,
	UseLinkOptions,
	UseLinkReturn
} from './types'