/**
 * uni.* 原生导航 API 的 Promise 化封装
 *
 * 跨端差异处理：
 * - Web（H5）：options 用 UTSJSONObject 构造，携带 animationType（H5 动画演示）；
 * - App / 小程序：uni.* 的 options 参数类型为具名 Options（NavigateToOptions 等），
 *   对象字面量构造即可（动画字段在原生端识别有差异，native 端不携带动画字段）。
 */
import { buildFullPath } from '../../utils'
import type { UniAnimation } from '../type'

/** uni.* API 失败回调负载 */
export interface UniFailure {
	errMsg?: string
}

/**
 * 将回调风格的 uni API 转换为 Promise
 * @param api - uni API 名称（仅用于错误提示）
 * @param executor - 包含 success/fail 回调的执行函数
 * @returns 成功 resolve、失败 reject 的 Promise
 */
export function promisifyUniApi(api: string, executor: (resolve: () => void, reject: (err: any) => void) => void): Promise<void> {
	return new Promise<void>((resolve, reject) => {
		try {
			executor(
				() => resolve(),
				(err: any) => {
					const fail = err as UniFailure
					const message = `${api} 调用失败: ${fail !== null && fail.errMsg !== null ? fail.errMsg : ''}`
					reject(new Error(message))
				}
			)
		} catch (e) {
			reject(e instanceof Error ? e : new Error(`${api} 调用异常`))
		}
	})
}

/**
 * 调用 uni.navigateTo 跳转到普通页面
 * @param anim - 窗口过渡动画（AnimationPlugin 注入；null 时不携带动画参数）
 */
export function uniNavigateTo(path: string, query: Map<string, string>, anim: UniAnimation | null = null): Promise<void> {
	const url = buildFullPath(path, query)
	return promisifyUniApi('navigateTo', (resolve, reject) => {
		// #ifndef WEB
		uni.navigateTo({ url: url, success: () => resolve(), fail: (err: any) => reject(err) })
		// #else
		const options = new UTSJSONObject()
		options['url'] = url
		options['success'] = () => resolve()
		options['fail'] = (err: any) => reject(err)
		if (anim != null && anim.type != null && anim.type.length > 0) {
			options['animationType'] = anim.type
			options['animationDuration'] = anim.duration === null ? 300 : anim.duration
		}
		uni.navigateTo(options)
		// #endif
	})
}

/**
 * 调用 uni.switchTab 切换 tabBar 页面
 */
export function uniSwitchTab(path: string): Promise<void> {
	return promisifyUniApi('switchTab', (resolve, reject) => {
		// #ifndef WEB
		uni.switchTab({ url: path, success: () => resolve(), fail: (err: any) => reject(err) })
		// #else
		const options = new UTSJSONObject()
		options['url'] = path
		options['success'] = () => resolve()
		options['fail'] = (err: any) => reject(err)
		uni.switchTab(options)
		// #endif
	})
}

/**
 * 调用 uni.redirectTo 替换当前页面
 */
export function uniRedirectTo(path: string, query: Map<string, string>, anim: UniAnimation | null = null): Promise<void> {
	const url = buildFullPath(path, query)
	return promisifyUniApi('redirectTo', (resolve, reject) => {
		// #ifndef WEB
		uni.redirectTo({ url: url, success: () => resolve(), fail: (err: any) => reject(err) })
		// #else
		const options = new UTSJSONObject()
		options['url'] = url
		options['success'] = () => resolve()
		options['fail'] = (err: any) => reject(err)
		if (anim != null && anim.type != null && anim.type.length > 0) {
			options['animationType'] = anim.type
			options['animationDuration'] = anim.duration === null ? 300 : anim.duration
		}
		uni.redirectTo(options)
		// #endif
	})
}

/**
 * 调用 uni.reLaunch 关闭所有页面并打开目标页面
 */
export function uniReLaunch(path: string, query: Map<string, string>, anim: UniAnimation | null = null): Promise<void> {
	const url = buildFullPath(path, query)
	return promisifyUniApi('reLaunch', (resolve, reject) => {
		// #ifndef WEB
		uni.reLaunch({ url: url, success: () => resolve(), fail: (err: any) => reject(err) })
		// #else
		const options = new UTSJSONObject()
		options['url'] = url
		options['success'] = () => resolve()
		options['fail'] = (err: any) => reject(err)
		if (anim != null && anim.type != null && anim.type.length > 0) {
			options['animationType'] = anim.type
			options['animationDuration'] = anim.duration === null ? 300 : anim.duration
		}
		uni.reLaunch(options)
		// #endif
	})
}

/**
 * 调用 uni.navigateBack 返回上一页
 * @param delta - 返回层级，需为正整数
 * @param anim - 窗口关闭动画（AnimationPlugin 注入；null 时不携带动画参数）
 */
export function uniNavigateBack(delta: number, anim: UniAnimation | null = null): Promise<void> {
	return promisifyUniApi('navigateBack', (resolve, reject) => {
		// #ifndef WEB
		uni.navigateBack({ delta: delta, success: () => resolve(), fail: (err: any) => reject(err) })
		// #else
		const options = new UTSJSONObject()
		options['delta'] = delta
		options['success'] = () => resolve()
		options['fail'] = (err: any) => reject(err)
		if (anim != null && anim.type != null && anim.type.length > 0) {
			options['animationType'] = anim.type
			options['animationDuration'] = anim.duration === null ? 300 : anim.duration
		}
		uni.navigateBack(options)
		// #endif
	})
}