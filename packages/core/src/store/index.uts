/**
 * 内部运行时单例
 *
 * 供组合式 API（useRoute / useRouter）在非 provide/inject 作用下或跨页读取
 * 当前活跃路由与路由器。单路由应用下足够；如多实例请依赖 provide/inject。
 */
import { shallowRef, type Ref } from 'vue'
import type { RouteLocation, Router } from '../types'

/** 空路由（占位） */
function emptyRoute(): RouteLocation {
	return {
		path: '/',
		name: undefined,
		meta: {},
		query: new Map(),
		params: new Map(),
		fullPath: '/',
		hash: '',
		matched: []
	}
}

/** 全局响应式当前路由 */
export const currentRoute: Ref<RouteLocation> = shallowRef<RouteLocation>(emptyRoute())

/** 全局活跃路由器 */
let globalRouter: Router | null = null

/**
 * 更新全局当前路由
 */
export function setGlobalCurrentRoute(to: RouteLocation): void {
	currentRoute.value = to
}

/**
 * 设置全局活跃路由器（install 时调用）
 */
export function setActiveGlobalRouter(router: Router | null): void {
	globalRouter = router
}

/**
 * 获取全局活跃路由器
 */
export function activeGlobalRouter(): Router | null {
	return globalRouter
}