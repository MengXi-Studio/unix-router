/**
 * 守卫返回结果解析
 *
 * 将守卫函数返回值转换为统一的 GuardResult：
 * - null / undefined / true → next（继续）
 * - false → abort（ABORTED）
 * - Error → abort（CANCELLED）
 * - string / 对象位置 / NavigationRedirect → redirect
 */
import type { NavigationGuardReturn, RawLocationLike, NavigationRedirect, NavigationRedirectMode, RouteLocation } from '../../types'
import { RouterErrorCode } from '../../enums'
import type { GuardResult } from '../type'

/**
 * 解析守卫返回值
 * @param value - 守卫返回值
 * @param to - 目标路由
 * @returns 解析后的守卫结果
 */
export function resolveGuardReturn(value: NavigationGuardReturn, to: RouteLocation): GuardResult {
	if (value === undefined || value === null || value === true) {
		return next()
	}
	if (value === false) {
		return abort(RouterErrorCode.ABORTED)
	}
	if (value instanceof Error) {
		return abort(RouterErrorCode.CANCELLED, value)
	}
	if (typeof value === 'string') {
		return redirect(value, undefined)
	}
	if (isRedirectObject(value)) {
		return redirect(value.location, value.mode)
	}
	// 普通对象位置
	const raw = value as RawLocationLike
	return redirect(raw, undefined)
}

/** 判断是否为拖带模式的对象 */
function isRedirectObject(value: object): boolean {
	const obj = value as NavigationRedirect
	return obj !== null && 'location' in obj && (obj.mode === 'push' || obj.mode === 'replace' || obj.mode === 'relaunch' || obj.mode === undefined)
}

export function next(): GuardResult {
	return { kind: 'next' }
}

export function abort(code: RouterErrorCode, error?: Error): GuardResult {
	return { kind: 'abort', code, error }
}

export function redirect(location: object | string, mode: NavigationRedirectMode | undefined): GuardResult {
	return { kind: 'redirect', redirect: location as never, mode }
}