/** 按分类取商品 */
export function goodsByCategory(key: string): Goods[] {
	const result: Goods[] = []
	for (let i = 0; i < goodsList.length; i++) {
		if (goodsList[i].category == key) {
			result.push(goodsList[i])
		}
	}
	return result
}

/** 按 id 取商品 */
export function goodsById(id: number): Goods | null {
	for (let i = 0; i < goodsList.length; i++) {
		if (goodsList[i].id == id) {
			return goodsList[i]
		}
	}
	return null
}

/** 格式化价格（元） */
export function formatPrice(price: number): string {
	return '¥' + Math.floor(price) + ''
}
