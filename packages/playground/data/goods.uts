// 商品域 mock 数据与查询工具（供列表/详情/分类/首页等页面使用）

/** 商品 */
export type Goods = {
	id: number
	name: string
	price: number
	/** 分类 key（对应 Category.key） */
	category: string
	tag: string
	desc: string
}

/** 分类 */
export type Category = {
	key: string
	name: string
}

