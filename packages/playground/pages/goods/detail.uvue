<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page" v-if="goods !== null">
			<view class="detail-thumb">
				<text class="thumb-tag">{{ tag() }}</text>
			</view>
			<text class="goods-name">{{ name() }}</text>
			<text class="goods-price">{{ price() }}</text>
			<text class="goods-desc">{{ desc() }}</text>

			<view class="from-tip" v-if="from !== ''">
				<text class="from-label">来源：</text>
				<text class="from-value">{{ from }}</text>
			</view>
			<view class="from-tip" v-if="evtBack !== ''">
				<text class="from-label">EventsPlugin：</text>
				<text class="from-value">{{ evtBack }}</text>
			</view>

			<view class="action-row">
				<button class="action-btn primary" @click="add">加入购物车</button>
				<button class="action-btn plain" @click="buyNow">立即购买</button>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
import { useRouter, useRoute, useOpenerEventChannel } from '@/uni_modules/ux-router/utssdk/index.uts'
import { goodsById, formatPrice as fmtPrice, addToCart, type Goods } from '../../router.uts'

const router = useRouter()
const route = useRoute()

/** 当前商品（onLoad 时按页面 query 读取；uvue 中路由状态同步晚于页面 onLoad） */
const goods = ref(null as Goods | null)
const from = ref('')
const evtBack = ref('')

/** 本地包装：外部顶层函数在非蒸汽 Kotlin 下以属性对象暴露，需转成本地函数供模板调用 */
function formatPrice(p: number): string { return fmtPrice(p) }

/** 模板访问器：goods 可空，Kotlin 需判空后再取字段，避免对 nullable 接收者调用 */
function tag(): string { return goods.value !== null ? goods.value!.tag : '' }
function name(): string { return goods.value !== null ? goods.value!.name : '' }
function desc(): string { return goods.value !== null ? goods.value!.desc : '' }
function price(): string { return goods.value !== null ? formatPrice(goods.value!.price) : '' }

onLoad((options: UTSJSONObject) => {
	const idStr = options['id'] as string | null
	if (idStr !== null && idStr.length > 0) {
		goods.value = goodsById(parseInt(idStr, 10))
	} else {
		goods.value = null
	}
})

onShow(() => {
	// 演示 EventsPlugin：打开方携带 events 时回传数据
	const channel = useOpenerEventChannel()
	if (channel !== null) {
		channel.emit('goodsDetailOpened', { id: goods.value !== null ? goods.value.id : 0, name: goods.value !== null ? goods.value.name : '' })
		evtBack.value = '已回传商品信息给打开页'
	} else {
		evtBack.value = ''
	}
	// params 传参来源（列表页可经 params 携带 from）
	const f = route.params.get('from')
	if (f !== null) {
		from.value = f
	} else {
		from.value = ''
	}
})

function add(): void {
	if (goods.value === null) return
	addToCart(goods.value)
	uni.showToast({ title: '已加入购物车', icon: 'none' })
}

function buyNow(): void {
	if (goods.value === null) return
	// 演示 params：把选中商品 id 传给结算页
	router.push({
		name: 'checkout',
		params: new Map([['goodsId', goods.value.id.toString()]])
	})
}
</script>

<style>
.container { flex: 1; }
.page { flex-direction: column; padding: 24rpx; }
.detail-thumb { height: 400rpx; border-radius: 16rpx; align-items: center; justify-content: center; background-color: #e8f1ff; margin-bottom: 24rpx; }
.thumb-tag { font-size: 32rpx; color: #007aff; }
.goods-name { font-size: 34rpx; font-weight: bold; color: #333; }
.goods-price { font-size: 40rpx; font-weight: bold; color: #dd524d; margin-top: 12rpx; }
.goods-desc { font-size: 26rpx; color: #666; margin-top: 20rpx; line-height: 1.6; }
.from-tip { flex-direction: row; margin-top: 20rpx; }
.from-label { font-size: 24rpx; color: #999; }
.from-value { font-size: 24rpx; color: #007aff; }
.action-row { flex-direction: row; margin-top: 48rpx; }
.action-btn { flex: 1; margin-right: 20rpx; border-radius: 44rpx; align-items: center; padding: 24rpx 0; font-size: 28rpx; }
.action-btn.primary { background-color: #007aff; color: #ffffff; }
.action-btn.plain { background-color: #f2f3f5; color: #333; }
</style>