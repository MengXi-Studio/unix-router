<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page">
			<view class="empty" v-if="cartItems.length === 0">
				<text class="empty-text">没有待结算的商品</text>
				<button class="go-btn" @click="goHome">去逛逛</button>
			</view>

			<view v-if="cartItems.length > 0">
				<view class="address-card">
					<text class="address-title">收货地址</text>
					<text class="address-detail">张同学 138****8888 · 北京市朝阳区梦曦街 1 号</text>
				</view>

				<view class="item-row" v-for="(item, i) in cartItems" :key="i">
					<text class="item-name">{{ item.goods.name }} ×{{ item.count }}</text>
					<text class="item-price">{{ formatPrice(item.goods.price * item.count) }}</text>
				</view>

				<view class="total-row">
					<text class="total-label">应付合计</text>
					<text class="total-price">{{ formatPrice(cartTotalPrice()) }}</text>
				</view>

				<button class="submit-btn" @click="submit">提交订单</button>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
import { useRouter } from '@/uni_modules/ux-router/utssdk/index.uts'
import { cartItems, cartTotalPrice as calTotal, clearCart, orders, formatPrice as fmtPrice, type Order } from '../../router.uts'

const router = useRouter()

/** 本地包装：外部顶层函数在非蒸汽 Kotlin 下以属性对象暴露，需转成本地函数供模板调用 */
function cartTotalPrice(): number { return calTotal() }
function formatPrice(p: number): string { return fmtPrice(p) }

/** 订单创建时间（先于 submit 声明，Kotlin 本地函数须先声明后使用） */
function currentTime(): string {
	const now = new Date()
	return now.getFullYear() + '-' + (now.getMonth() + 1) + '-' + now.getDate()
}

function submit(): void {
	if (cartItems.length === 0) return
	const order: Order = {
		id: 'NO' + Date.now().toString(),
		items: cartItems.slice(0),
		total: cartTotalPrice(),
		createdAt: currentTime()
	}
	orders.push(order)
	clearCart()
	uni.showToast({ title: '下单成功', icon: 'success' })
	router.replace({ name: 'orders' })
}

function goHome(): void {
	router.push({ name: 'home' })
}
</script>

<style>
.container { flex: 1; }
.page { flex-direction: column; padding: 24rpx; }
.empty { flex-direction: column; align-items: center; padding: 120rpx 0; }
.empty-text { font-size: 28rpx; color: #999; }
.go-btn { margin-top: 24rpx; background-color: #007aff; color: #ffffff; border-radius: 40rpx; padding: 16rpx 48rpx; font-size: 26rpx; }
.address-card { background-color: #ffffff; border-radius: 12rpx; border-width: 1rpx; border-color: #eee; padding: 24rpx; margin-bottom: 24rpx; }
.address-title { font-size: 28rpx; font-weight: bold; color: #333; }
.address-detail { font-size: 24rpx; color: #666; margin-top: 12rpx; }
.item-row { flex-direction: row; align-items: center; justify-content: space-between; background-color: #ffffff; border-radius: 12rpx; border-width: 1rpx; border-color: #eee; padding: 24rpx; margin-bottom: 16rpx; }
.item-name { font-size: 26rpx; color: #333; flex: 1; }
.item-price { font-size: 26rpx; color: #dd524d; }
.total-row { flex-direction: row; align-items: center; justify-content: flex-end; margin-top: 20rpx; }
.total-label { font-size: 26rpx; color: #333; margin-right: 16rpx; }
.total-price { font-size: 40rpx; font-weight: bold; color: #dd524d; }
.submit-btn { margin-top: 40rpx; background-color: #007aff; color: #ffffff; border-radius: 44rpx; padding: 24rpx 0; font-size: 30rpx; }
</style>