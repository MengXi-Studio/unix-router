<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page">
			<!-- 顶部横幅 -->
			<view class="banner">
				<text class="banner-title">梦曦商城</text>
				<text class="banner-sub">@meng-xi/unix-router 电商示例</text>
			</view>

			<!-- 分类快捷入口 -->
			<text class="section-title">商品分类</text>
			<scroll-view class="cat-scroll" scroll-x="true" show-scrollbar="false">
				<view class="cat-row">
					<view class="cat-chip" v-for="(c, i) in categories" :key="i" @click="goCategory(c.key)">
						<text class="cat-name">{{ c.name }}</text>
					</view>
				</view>
			</scroll-view>

			<!-- RouterLink 声明式导航（组件演示，无需点击处理） -->
			<text class="section-title">推荐商品</text>
			<view class="goods-grid">
				<view class="goods-card" v-for="(g, i) in recommend" :key="i" @click="goDetail(g.id)">
					<view class="goods-thumb">
						<text class="thumb-tag">{{ g.tag }}</text>
					</view>
					<text class="goods-name">{{ g.name }}</text>
					<text class="goods-price">{{ formatPrice(g.price) }}</text>
				</view>
			</view>

			<RouterLink to="pages/cart/cart" class="cart-link">
				<text class="cart-link-text">去购物车 →</text>
			</RouterLink>

			<view class="evt-box" v-if="evtMsg.length > 0">
				<text class="evt-text">{{ evtMsg }}</text>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
// 页面声明宏：编译期由 @meng-xi/unix-router/vite-plugin 剥离，驱动 pages.json 与路由表生成
defineUniPage({
	title: '梦曦商城',
	name: 'home',
	isTab: true,
	tab: { order: 0, text: '首页', iconPath: 'static/tabbar/home.png', selectedIconPath: 'static/tabbar/home-active.png' }
})
import { useRouter, useRoute, RouterLink } from '@/uni_modules/ux-router/utssdk/index.uts'
import { categories, goodsList, formatPrice as fmtPrice, type Goods } from '../../data/goods.uts'

const router = useRouter()
const route = useRoute()

/** 本地包装：外部顶层函数在非蒸汽 Kotlin 下以属性对象暴露，需转成本地函数供模板调用 */
function formatPrice(p: number): string { return fmtPrice(p) }

/** 首页推荐的 4 个商品 */
const recommend: Goods[] = goodsList.slice(0, 4)

/** EventsPlugin 演示：详情页回传的数据（打开时携带 events，被打开页经 EventChannel 回传） */
const evtMsg = ref('')

function goCategory(key: string): void {
	router.push({ path: 'pages-sub/goods/list', query: new Map([['category', key]]) })
}

function goDetail(id: number): void {
	// 携带 events 监听表：监听被打开页（详情页）回传的数据
	// 回调显式返回 any：原生端 events 回调以 Function1<Any, Any> 承载，返回 void 会因型变不匹配
	const events: Map<string, (data: any) => any> = new Map<string, (data: any) => any>()
	events.set('goodsDetailOpened', (data: any): any => {
		const d = data as UTSJSONObject
		evtMsg.value = '详情页回传: ' + (d['id'] as number).toString() + ' - ' + (d['name'] as string)
		return '' as any
	})
	router.push({ path: 'pages-sub/goods/detail', query: new Map([['id', id.toString()]]), events })
}
</script>

<style>
.container { flex: 1; background-color: #f5f6f8; }
.page { flex-direction: column; padding: 24rpx; }
.banner { flex-direction: column; align-items: center; background-color: #ff6034; border-radius: 20rpx; padding: 56rpx 0; margin-bottom: 32rpx; }
.banner-title { font-size: 44rpx; font-weight: bold; color: #ffffff; }
.banner-sub { font-size: 24rpx; color: #ffe3d9; margin-top: 12rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 20rpx; }
.cat-scroll { width: 100%; margin-bottom: 32rpx; }
.cat-row { flex-direction: row; }
.cat-chip { background-color: #ffffff; border-radius: 32rpx; padding: 14rpx 32rpx; margin-right: 20rpx; }
.cat-name { font-size: 26rpx; color: #666666; }
.goods-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.goods-card { width: 48%; background-color: #ffffff; border-radius: 20rpx; margin-bottom: 20rpx; padding: 20rpx; }
.goods-thumb { height: 200rpx; border-radius: 16rpx; align-items: center; justify-content: center; background-color: #fff1ec; margin-bottom: 16rpx; }
.thumb-tag { font-size: 24rpx; color: #ff6034; }
.goods-name { font-size: 26rpx; color: #1a1a1a; margin-bottom: 8rpx; }
.goods-price { font-size: 30rpx; font-weight: bold; color: #f2270c; }
.cart-link { margin-top: 12rpx; padding: 24rpx; align-items: center; background-color: #ffffff; border-radius: 44rpx; }
.cart-link-text { font-size: 28rpx; color: #ff6034; }
.evt-box { margin-top: 20rpx; padding: 24rpx; align-items: center; background-color: #e8f8ec; border-radius: 20rpx; }
.evt-text { font-size: 26rpx; color: #07c160; }
</style>
