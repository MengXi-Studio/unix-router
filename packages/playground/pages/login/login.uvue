<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page">
			<view class="login-logo">
				<text class="logo-text">梦曦商城</text>
				<text class="logo-sub">登录后可使用购物车结算</text>
			</view>
			<view class="input-row">
				<text class="input-label">账号</text>
				<input class="input" v-model="account" placeholder="演示账号：任意输入" />
			</view>
			<view class="input-row">
				<text class="input-label">密码</text>
				<input class="input" v-model="password" placeholder="演示密码：任意输入" type="password" />
			</view>
			<button class="login-btn" @click="doLogin">登 录</button>
			<text class="login-tip">由守卫 beforeEach（requireAuth）重定向而来，登录后自动回跳</text>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
import { useRouter, useRoute } from '@/uni_modules/ux-router/utssdk/index.uts'
import { setLoggedIn } from '../../router.uts'

const router = useRouter()
const route = useRoute()
const account = ref('')
const password = ref('')

function doLogin(): void {
	setLoggedIn(true)
	uni.showToast({ title: '登录成功', icon: 'success' })
	// 读取守卫写入的 redirect 查询参数，回跳原目标页
	const redirect = route.query.get('redirect')
	if (redirect !== null && redirect.length > 0) {
		router.replace(redirect)
	} else {
		router.replace({ name: 'home' })
	}
}
</script>

<style>
.container { flex: 1; }
.page { flex-direction: column; padding: 48rpx 32rpx; }
.login-logo { flex-direction: column; align-items: center; margin-bottom: 64rpx; }
.logo-text { font-size: 44rpx; font-weight: bold; color: #007aff; }
.logo-sub { font-size: 24rpx; color: #999; margin-top: 12rpx; }
.input-row { flex-direction: row; align-items: center; background-color: #ffffff; border-radius: 12rpx; border-width: 1rpx; border-color: #eee; padding: 24rpx; margin-bottom: 24rpx; }
.input-label { font-size: 28rpx; color: #333; width: 120rpx; }
.input { flex: 1; font-size: 28rpx; }
.login-btn { margin-top: 24rpx; background-color: #007aff; color: #ffffff; border-radius: 44rpx; padding: 24rpx 0; font-size: 30rpx; }
.login-tip { font-size: 22rpx; color: #999; margin-top: 24rpx; text-align: center; }
</style>