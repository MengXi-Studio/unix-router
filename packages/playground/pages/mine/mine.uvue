<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page">
			<view class="profile">
				<view class="avatar">
					<text class="avatar-text">{{ isLoggedIn() ? '曦' : '客' }}</text>
				</view>
				<text class="profile-name">{{ isLoggedIn() ? '梦曦商城会员' : '未登录' }}</text>
				<text class="profile-desc">{{ isLoggedIn() ? '欢迎回来' : '登录后体验完整功能' }}</text>
			</view>

			<view class="order-bar">
				<view class="order-item" @click="goOrders">
					<text class="order-num">{{ orders.length }}</text>
					<text class="order-label">我的订单</text>
				</view>
				<view class="order-item" @click="goCart">
					<text class="order-num">{{ cartTotalCount() }}</text>
					<text class="order-label">购物车</text>
				</view>
			</view>

			<view class="menu">
				<view class="menu-item" @click="goCart">
					<text class="menu-label">购物车</text>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-item" @click="goOrders">
					<text class="menu-label">我的订单</text>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-item" @click="goProfile">
					<text class="menu-label">个人资料（分包 · requireAuth）</text>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-item" @click="goDemo">
					<text class="menu-label">路由能力演示（分包）</text>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-item" @click="goSetting">
					<text class="menu-label">设置（分包 · beforeEnter）</text>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-item" @click="goHome">
					<text class="menu-label">回到首页</text>
					<text class="menu-arrow">›</text>
				</view>
			</view>

			<view class="login-box">
				<view class="login-btn" :class="loginBtnClass()" @click="toggleLogin">
					<text class="login-text" :class="loginTextClass()">{{ isLoggedIn() ? '退出登录' : '去登录' }}</text>
				</view>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
// 页面声明宏：编译期由 @meng-xi/unix-router/vite-plugin 剥离，驱动 pages.json 与路由表生成
defineUniPage({
	title: '我的',
	name: 'mine',
	isTab: true,
	tab: { order: 2, text: '我的', iconPath: 'static/tabbar/mine.png', selectedIconPath: 'static/tabbar/mine-active.png' }
})
import { useRouter } from '@/uni_modules/ux-router/utssdk/index.uts'
import { isLoggedIn as isLoggedIn$1, setLoggedIn, orders, cartTotalCount as calCount } from '../../store/index.uts'

const router = useRouter()

/** 本地包装：外部顶层函数在非蒸汽 Kotlin 下以属性对象暴露，需转成本地函数供模板调用 */
function isLoggedIn(): boolean { return isLoggedIn$1() }
function cartTotalCount(): number { return calCount() }

/** 登录按钮 class（模板内联 class 对象在 Kotlin 下无法推断泛型，改由本地函数返回） */
function loginBtnClass(): Map<string, boolean> {
	const m = new Map<string, boolean>()
	m.set('logout', isLoggedIn())
	return m
}

/** 登录文字 class（ucss 不支持复合/后代选择器，动态类切换文字颜色） */
function loginTextClass(): Map<string, boolean> {
	const m = new Map<string, boolean>()
	m.set('logout-text', isLoggedIn())
	return m
}

function goCart(): void {
	router.push({ name: 'cart' })
}

function goOrders(): void {
	router.push({ name: 'orders' })
}

/** 个人资料页（分包页面，验证全局守卫 requireAuth + eventBus 广播） */
function goProfile(): void {
	router.push({ name: 'profile' })
}

/** 路由能力演示页（分包页面，聚合演示动画覆盖 / 错误捕获 / eventBus / queryNumber） */
function goDemo(): void {
	router.push({ name: 'demo' })
}

/** 设置页（分包页面，验证 beforeEnter 独享守卫） */
function goSetting(): void {
	router.push({ name: 'setting' })
}

function goHome(): void {
	router.push({ name: 'home' })
}

function toggleLogin(): void {
	if (isLoggedIn()) {
		setLoggedIn(false)
		uni.removeStorageSync('route-gen-logged')
		uni.showToast({ title: '已退出登录', icon: 'none' })
	} else {
		setLoggedIn(true)
		uni.showToast({ title: '已登录（演示）', icon: 'none' })
	}
}
</script>

