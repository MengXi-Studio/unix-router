.order-item { flex: 1; flex-direction: column; align-items: center; }
.order-num { font-size: 36rpx; font-weight: bold; color: #1a1a1a; }
.order-label { font-size: 24rpx; color: #9a9a9a; margin-top: 8rpx; }
.menu { background-color: #ffffff; border-radius: 20rpx; }
.menu-item { flex-direction: row; align-items: center; justify-content: space-between; padding: 28rpx; border-bottom-width: 1rpx; border-bottom-color: #f5f5f5; }
