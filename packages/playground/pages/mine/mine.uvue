<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page">
			<view class="profile">
				<view class="avatar">
					<text class="avatar-text">{{ isLoggedIn() ? '曦' : '客' }}</text>
				</view>
				<text class="profile-name">{{ isLoggedIn() ? '梦曦商城会员' : '未登录' }}</text>
				<text class="profile-desc">{{ isLoggedIn() ? '欢迎回来' : '登录后体验完整功能' }}</text>
			</view>

			<view class="order-bar">
				<view class="order-item" @click="goOrders">
					<text class="order-num">{{ orders.length }}</text>
					<text class="order-label">我的订单</text>
				</view>
				<view class="order-item" @click="goCart">
					<text class="order-num">{{ cartTotalCount() }}</text>
					<text class="order-label">购物车</text>
				</view>
			</view>

			<view class="menu">
				<view class="menu-item" @click="goCart">
					<text class="menu-label">购物车</text>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-item" @click="goOrders">
					<text class="menu-label">我的订单</text>
					<text class="menu-arrow">›</text>
				</view>
				<view class="menu-item" @click="goHome">
					<text class="menu-label">回到首页</text>
					<text class="menu-arrow">›</text>
				</view>
			</view>

			<view class="login-box">
				<button class="login-btn" :class="{ logout: isLoggedIn() }" @click="toggleLogin">
					<text class="login-text">{{ isLoggedIn() ? '退出登录' : '去登录' }}</text>
				</button>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
import { useRouter } from '@/uni_modules/ux-router/utssdk/index.uts'
import { isLoggedIn, setLoggedIn, orders, cartTotalCount } from '../../router.uts'

const router = useRouter()

function goCart(): void {
	router.push({ name: 'cart' })
}

function goOrders(): void {
	router.push({ name: 'orders' })
}

function goHome(): void {
	router.push({ name: 'home' })
}

function toggleLogin(): void {
	if (isLoggedIn()) {
		setLoggedIn(false)
		uni.showToast({ title: '已退出登录', icon: 'none' })
	} else {
		setLoggedIn(true)
		uni.showToast({ title: '已登录（演示）', icon: 'none' })
	}
}
</script>

<style>
.container { flex: 1; }
.page { flex-direction: column; padding: 24rpx; }
.profile { flex-direction: column; align-items: center; padding: 48rpx 0 32rpx; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 60rpx; align-items: center; justify-content: center; background-color: #007aff; margin-bottom: 16rpx; }
.avatar-text { font-size: 48rpx; color: #ffffff; font-weight: bold; }
.profile-name { font-size: 32rpx; font-weight: bold; color: #333; }
.profile-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.order-bar { flex-direction: row; background-color: #ffffff; border-radius: 12rpx; border-width: 1rpx; border-color: #eee; padding: 32rpx 0; margin-bottom: 24rpx; }
.order-item { flex: 1; flex-direction: column; align-items: center; }
.order-num { font-size: 36rpx; font-weight: bold; color: #333; }
.order-label { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.menu { background-color: #ffffff; border-radius: 12rpx; border-width: 1rpx; border-color: #eee; }
.menu-item { flex-direction: row; align-items: center; justify-content: space-between; padding: 28rpx; border-bottom-width: 1rpx; border-bottom-color: #f2f3f5; }
.menu-label { font-size: 28rpx; color: #333; }
.menu-arrow { font-size: 36rpx; color: #ccc; }
.login-box { margin-top: 40rpx; }
.login-btn { background-color: #007aff; border-radius: 44rpx; align-items: center; padding: 24rpx 0; }
.login-btn.logout { background-color: #f2f3f5; }
.login-text { font-size: 30rpx; color: #ffffff; }
.login-btn.logout .login-text { color: #333; }
</style>