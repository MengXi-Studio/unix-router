<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page">
			<text class="section-title">全部分类</text>
			<view class="cat-grid">
				<view class="cat-card" v-for="(c, i) in categories" :key="i" @click="goList(c.key)">
					<view class="cat-icon">
						<text class="cat-icon-text">{{ c.name.substring(0, 1) }}</text>
					</view>
					<text class="cat-name">{{ c.name }}</text>
					<text class="cat-count">{{ countByKey(c.key) }} 件商品</text>
				</view>
			</view>

			<text class="section-title">全部商品</text>
			<view class="goods-grid">
				<view class="goods-card" v-for="(g, i) in allGoods" :key="i" @click="goDetail(g.id)">
					<view class="goods-thumb">
						<text class="thumb-tag">{{ g.tag }}</text>
					</view>
					<text class="goods-name">{{ g.name }}</text>
					<text class="goods-price">{{ formatPrice(g.price) }}</text>
				</view>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
// 页面声明宏：编译期由 @meng-xi/unix-router/vite-plugin 剥离，驱动 pages.json 与路由表生成
defineUniPage({
	title: '分类',
	name: 'category',
	isTab: true,
	tab: { order: 1, text: '分类', iconPath: 'static/tabbar/category.jpg', selectedIconPath: 'static/tabbar/category-active.jpg' }
})
import { useRouter } from '@/uni_modules/ux-router/utssdk/index.uts'
import { categories, goodsList, goodsByCategory, formatPrice as fmtPrice, type Goods } from '../../data/goods.uts'

const router = useRouter()
const allGoods: Goods[] = goodsList

/** 本地包装：外部顶层函数在非蒸汽 Kotlin 下以属性对象暴露，需转成本地函数供模板调用 */
function formatPrice(p: number): string { return fmtPrice(p) }

/** 分类商品数量（模板中调用；uvue 模板不支持链式表达式） */
function countByKey(key: string): number {
	return goodsByCategory(key).length
}

function goList(key: string): void {
	router.push({ path: 'pages-sub/goods/list', query: new Map([['category', key]]) })
}

function goDetail(id: number): void {
	router.push({ path: 'pages-sub/goods/detail', query: new Map([['id', id.toString()]]) })
}
</script>

<style>
.container { flex: 1; background-color: #f5f6f8; }
.page { flex-direction: column; padding: 24rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #1a1a1a; margin-bottom: 20rpx; }
.cat-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 32rpx; }
.cat-card { width: 31%; background-color: #ffffff; border-radius: 20rpx; align-items: center; padding: 24rpx 0; margin-bottom: 20rpx; }
.cat-icon { width: 88rpx; height: 88rpx; border-radius: 44rpx; align-items: center; justify-content: center; background-color: #fff1ec; margin-bottom: 12rpx; }
.cat-icon-text { font-size: 36rpx; color: #ff6034; font-weight: bold; }
.cat-name { font-size: 26rpx; color: #1a1a1a; }
.cat-count { font-size: 22rpx; color: #9a9a9a; margin-top: 6rpx; }
.goods-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.goods-card { width: 48%; background-color: #ffffff; border-radius: 20rpx; margin-bottom: 20rpx; padding: 20rpx; }
.goods-thumb { height: 200rpx; border-radius: 16rpx; align-items: center; justify-content: center; background-color: #fff1ec; margin-bottom: 16rpx; }
.thumb-tag { font-size: 24rpx; color: #ff6034; }
.goods-name { font-size: 26rpx; color: #1a1a1a; margin-bottom: 8rpx; }
.goods-price { font-size: 30rpx; font-weight: bold; color: #f2270c; }
</style>
