{"code":"/**\n * 导航分发器\n *\n * 根据目标是否为 tabBar 页面（meta.isTab）在 uni.* 各导航 API 间分发：\n * - push(normal) → uni.navigateTo；push(tab) → uni.switchTab\n * - replace(normal) → uni.redirectTo；replace(tab) → uni.switchTab\n * - relaunch(normal) → uni.reLaunch；relaunch(tab) → uni.switchTab\n * - back → uni.navigateBack\n */\nimport { UniNavigationOptions } from './type';\nimport { uniNavigateTo, uniSwitchTab, uniRedirectTo, uniReLaunch, uniNavigateBack } from './helpers/uni-api';\n/**\n * 执行前进导航（push）\n */\nexport function navigateTo(options) {\n    if (options.isTab) {\n        return uniSwitchTab(options.path);\n    }\n    return uniNavigateTo(options.path, options.query);\n}\n/**\n * 执行替换导航（replace）\n */\nexport function replaceTo(options) {\n    if (options.isTab) {\n        return uniSwitchTab(options.path);\n    }\n    return uniRedirectTo(options.path, options.query);\n}\n/**\n * 执行重启动导航（relaunch）\n */\nexport function relaunchTo(options) {\n    if (options.isTab) {\n        return uniSwitchTab(options.path);\n    }\n    return uniReLaunch(options.path, options.query);\n}\n/**\n * 执行返回导航（back）\n */\nexport function goBack(delta) {\n    return uniNavigateBack(delta);\n}\n//# sourceMappingURL=E:/Github%20PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/navigation/index.uts.js.map","references":["E:/Github PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/navigation/type.uts","E:/Github PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/navigation/helpers/uni-api.uts"],"utsMeta":{},"map":"{\"version\":3,\"file\":\"index.uts.js\",\"sourceRoot\":\"\",\"sources\":[\"index.uts\"],\"names\":[],\"mappings\":\"AAAA;;;;;;;;GAQG;AACH,OAAY,EAAE,oBAAoB,EAAE,MAAM,QAAQ,CAAA;AAClD,OAAO,EAAE,aAAa,EAAE,YAAY,EAAE,aAAa,EAAE,WAAW,EAAE,eAAe,EAAE,MAAM,mBAAmB,CAAA;AAE5G;;GAEG;AACH,MAAM,UAAU,UAAU,CAAC,OAA6B;IACvD,IAAI,OAAO,CAAC,KAAK,EAAE;QAClB,OAAO,YAAY,CAAC,OAAO,CAAC,IAAI,CAAC,CAAA;KACjC;I