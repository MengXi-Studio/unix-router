{"code":"/**\n * 组件内导航守卫（组合式 API）\n *\n * uni-app x 中页面每次导航都会创建新实例（无 keep-alive 复用），因此：\n * - onBeforeRouteLeave：在本页面注册，离开该页面时触发（最常用）\n * - onBeforeRouteEnter：当再次导航进入该路径时触发（首次进入已在创建途中，效果有限）\n * - onBeforeRouteUpdate：路径未变参数变化的场景在静态页模型中极少触发\n *\n * 实现方式：注册一个过滤后的全局解析守卫，故可与 router.beforeResolve 协同。\n */\nimport {} from '../../types';\nimport { useRouter } from '../router';\n/**\n * 注册组件内离开守卫\n * @param guard - 离开守卫（返回 false 可阻止离开）\n */\nexport function onBeforeRouteLeave(guard) {\n    const router = useRouter();\n    const currentPath = router.currentRoute.path;\n    router.beforeResolve((to, from) => {\n        // 仅在离开当前页面时应用\n        if (from.path !== currentPath) {\n            return true;\n        }\n        return guard(to, from);\n    });\n}\n/**\n * 注册组件内进入守卫\n * @param guard - 进入守卫\n */\nexport function onBeforeRouteEnter(guard) {\n    const router = useRouter();\n    const path = router.currentRoute.path;\n    router.beforeResolve((to, from) => {\n        if (to.path !== path) {\n            return true;\n        }\n        return guard(to, from);\n    });\n}\n/**\n * 注册组件内更新守卫\n * @param guard - 更新守卫\n */\nexport function onBeforeRouteUpdate(guard) {\n    const router = useRouter();\n    const path = router.currentRoute.path;\n    router.beforeResolve((to, from) => {\n        if (to.path !== path || from.path !== path) {\n            return true;\n        }\n        return guard(to, from);\n    });\n}\n//# sourceMappingURL=E:/Github%20PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/composables/guard/route-guards.uts.js.map","references":["E:/Github PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/types/index.uts","E:/Github PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/composables/router.uts"],"utsMeta":{},"map":"{\"version\":3,\"file\":\"route-guards.uts.js\",\"sourceRoot\":\"\",\"sources\":[\"route-guards.uts\"],\"names\":[],\"mappings\":\"AAAA