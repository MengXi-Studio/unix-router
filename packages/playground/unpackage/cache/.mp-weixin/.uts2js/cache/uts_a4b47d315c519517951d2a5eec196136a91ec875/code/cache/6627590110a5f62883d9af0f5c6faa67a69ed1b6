{"code":"/**\n * uni-app x 页面栈历史适配\n *\n * vue-router 依赖 URL/history，而 uni-app x 以原生页面栈（getCurrentPages）为历史。\n * 本模块将页面栈封装为\"当前历史\"：支持读取当前页 path/query，并通过匹配器解析为 RouteLocation。\n * 非 uni 环境安全回退。\n */\nimport { RouteLocation } from '../types';\nimport { RouteMatcher } from '../matcher/type';\nimport { getCurrentPagesSafe } from '../navigation/context';\nexport class UniHistory {\n    constructor(matcher) {\n        this.matcher = matcher;\n    }\n    /** 获取当前页原始信息（页面栈顶） */\n    currentStack() {\n        const pages = getCurrentPagesSafe();\n        if (pages.length === 0) {\n            return { path: '/', query: new Map() };\n        }\n        const page = pages[pages.length - 1];\n        const path = '/' + page.route;\n        const query = new Map();\n        const options = page.options;\n        if (options !== undefined && options !== null) {\n            for (const key in options) {\n                if (Object.prototype.hasOwnProperty.call(options, key)) {\n                    query.set(key, options[key]);\n                }\n            }\n        }\n        return { path, query };\n    }\n    /**\n     * 将当前页面栈解析为 RouteLocation（经由匹配器补充名称与 meta）\n     */\n    resolveCurrent() {\n        const stack = this.currentStack();\n        // 直接以 path?query 字符串形式交由匹配器解析，兼容 __params__ 读取\n        const q = stack.query;\n        let full = stack.path;\n        let first = true;\n        q.forEach((value, key) => {\n            full += (first ? '?' : '&') + key + '=' + encodeURIComponent(value);\n            first = false;\n        });\n        return this.matcher.resolve(full);\n    }\n}\n//# sourceMappingURL=E:/Github%20PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/history/uni-history.uts.js.map","references":["E:/Github PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/types/index.uts","E:/Github PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/matcher/type