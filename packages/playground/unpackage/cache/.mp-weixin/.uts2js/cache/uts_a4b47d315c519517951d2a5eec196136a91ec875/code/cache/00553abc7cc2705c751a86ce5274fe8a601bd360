{"code":"/**\n * 平台判断工具\n *\n * uni-app x 逻辑层通过 uni.getSystemInfoSync() / uni.getAppBaseInfo() 获取平台。\n * 与 uni-app 标准版共用 uni 全局，但可通过 uniPlatform 与特定标志区分。\n */\nexport class PlatformInfo {\n    constructor() {\n        /** 是否为 App 端（Android / iOS，含蒸汽模式与 VDOM） */\n        this.isApp = false;\n        /** 是否为 H5 / Web 端 */\n        this.isH5 = false;\n        /** 是否为微信小程序端 */\n        this.isMpWeixin = false;\n        /** 是否为 uni-app x 运行时（区别于 uni-app 标准版） */\n        this.isAppX = false;\n        /** 原始平台标识 */\n        this.uniPlatform = 'web';\n    }\n}\n/** 全局缓存的平台信息 */\nlet cached = null;\n/**\n * 获取当前平台信息（带缓存）\n * 在非 uni 环境（如纯 Node / 单测）下安全回退为 web。\n */\nexport function getPlatform() {\n    if (cached !== null) {\n        return cached;\n    }\n    const info = new PlatformInfo();\n    try {\n        // uni.getAppBaseInfo() 返回 GetAppBaseInfoResult 对象，uniPlatform 为对象字段（非 Map）\n        const appBase = uni.getAppBaseInfo();\n        const platform = appBase.uniPlatform === undefined ? null : appBase.uniPlatform;\n        info.uniPlatform = platform !== null && platform.length > 0 ? platform : 'web';\n        info.isApp = platform === 'app';\n        info.isH5 = platform === 'web';\n        info.isMpWeixin = platform === 'mp-weixin';\n        // App 端运行在 uni-app x 编译器下的特征：存在 APP-X 编译常量；\n        // 归并判断：App 端在 uni-app x 中以蒸汽/VDOM 运行，统一视为 isAppX\n        info.isAppX = info.isApp || platform === 'app';\n    }\n    catch (e) {\n        // 非 uni 环境，回退为 web\n        info.uniPlatform = 'web';\n        info.isH5 = true;\n    }\n    cached = info;\n    return info;\n}\n//# sourceMappingURL=E:/Github%20PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/utils/platform.uts.js.map","references":[],"utsMeta":{"uniExtApis":["uni.getAppBaseInfo"]},"map":"{\"version\":3,\"file\":\"platform.uts.js\",\"sourceRoot\":\"\",\"sources\":[\"platform.uts\"],\"names\":[],\"mappings\":\"AAAA;;;;;GAKG;AAEH,MAAM,OAAO,YAAY;IAAzB;QACC,2CAA2C;QAC3C,UAAK,GAAY,KAAK,C