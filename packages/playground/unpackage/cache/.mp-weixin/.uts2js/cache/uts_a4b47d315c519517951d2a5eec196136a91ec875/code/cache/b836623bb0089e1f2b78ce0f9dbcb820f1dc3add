{"code":"/**\n * 守卫管理器实现\n */\nimport { RouteConfig, RouteLocation } from '../types';\nimport { runGuardQueue, runBeforeEnterGuards, runAfterGuards } from './helpers/run';\nimport { GuardManager, GuardResult } from './type';\nexport { GuardManager, GuardResult } from './type';\n/**\n * 创建守卫管理器，维护 beforeEach / beforeResolve / afterEach 队列并暴露执行方法\n */\nexport function createGuardManager() {\n    const beforeEachGuards = [];\n    const beforeResolveGuards = [];\n    const afterGuards = [];\n    function register(list, guard) {\n        list.push(guard);\n        return () => {\n            const index = list.indexOf(guard);\n            if (index > -1) {\n                list.splice(index, 1);\n            }\n        };\n    }\n    return new GuardManager({\n        beforeEach: guard => { return register(beforeEachGuards, guard); },\n        beforeResolve: guard => { return register(beforeResolveGuards, guard); },\n        afterEach: (guard) => {\n            afterGuards.push(guard);\n            return () => {\n                const index = afterGuards.indexOf(guard);\n                if (index > -1) {\n                    afterGuards.splice(index, 1);\n                }\n            };\n        },\n        runBeforeEach: (to, from, timeout) => { return runGuardQueue(beforeEachGuards, to, from, timeout); },\n        runBeforeResolve: (to, from, timeout) => { return runGuardQueue(beforeResolveGuards, to, from, timeout); },\n        runAfter: (to, from, failure = null) => { return runAfterGuards(afterGuards, to, from, failure); },\n        runBeforeEnter: (config, to, from, timeout) => { return runBeforeEnterGuards(config, to, from, timeout); }\n    });\n}\n//# sourceMappingURL=E:/Github%20PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/guard/index.uts.js.map","references":["E:/Github PedroQue99/MengXi-Studio/unix-router/packages/playground/uni_modules/ux-router/utssdk/types/index.uts","E:/Github PedroQue99/MengXi-Studio/unix-router