{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"jsx": "preserve",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"allowJs": true,
		"baseUrl": ".",
		"types": ["@dcloudio/types"]
	},
	"include": ["src/**/*.ts", "src/**/*.uts", "src/**/*.uvue", "src/**/*.d.uts", "src/**/*.json"]
}