<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page">
			<view class="count-tip">
				<text class="count-text">共 {{ list.length }} 件商品</text>
			</view>

			<view class="goods-card" v-for="(g, i) in list" :key="i" @click="goDetail(g.id)">
				<view class="goods-thumb">
					<text class="thumb-tag">{{ g.tag }}</text>
				</view>
				<view class="goods-info">
					<text class="goods-name">{{ g.name }}</text>
					<text class="goods-desc">{{ g.desc }}</text>
					<view class="bottom-row">
						<text class="goods-price">{{ formatPrice(g.price) }}</text>
						<view class="add-btn" @click.stop="add(g)">
							<text class="add-btn-text">加入购物车</text>
						</view>
					</view>
				</view>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
// 页面声明宏：编译期由 @meng-xi/unix-router/vite-plugin 剥离，驱动 pages.json 与路由表生成
defineUniPage({
	title: '商品列表',
	name: 'goods-list'
})
import { useRouter, useRoute } from '@/uni_modules/ux-router/utssdk/index.uts'
import { goodsByCategory, goodsList, formatPrice as fmtPrice, type Goods } from '../../data/goods.uts'
import { addToCart } from '../../store/index.uts'

const router = useRouter()
const route = useRoute()

/** 本地包装：外部顶层函数在非蒸汽 Kotlin 下以属性对象暴露，需转成本地函数供模板调用 */
function formatPrice(p: number): string { return fmtPrice(p) }

/** 当前分类商品（onLoad 时按页面 query 读取；此时路由状态尚未同步到 currentRoute） */
const list = ref([] as Goods[])

onLoad((options: UTSJSONObject) => {
	// H5 端 options 缺 key 返回 undefined（非 null），先归一化再判空（跨端空值判断）
	const category: string | null = (options['category'] ?? null) as string | null
	if (category !== null && category.length > 0) {
		list.value = goodsByCategory(category)
	} else {
		list.value = goodsList
	}
})

onShow(() => {
	// back 返回本页等二次进入时按当前 query 刷新（query 为空则跳过，保留 onLoad 结果）
	const c = route.query.get('category')
	if (c !== null && c.length > 0) {
		list.value = goodsByCategory(c)
	}
})

function goDetail(id: number): void {
	router.push({ path: 'pages-sub/goods/detail', query: new Map([['id', id.toString()]]) })
}

function add(g: Goods): void {
	addToCart(g)
	uni.showToast({ title: '已加入购物车', icon: 'none' })
}
</script>

<style>
.container { flex: 1; background-color: #f5f6f8; }
.page { flex-direction: column; padding: 24rpx; }
.count-tip { margin-bottom: 20rpx; }
.count-text { font-size: 24rpx; color: #9a9a9a; }
.goods-card { flex-direction: row; background-color: #ffffff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.goods-thumb { width: 180rpx; height: 180rpx; border-radius: 16rpx; align-items: center; justify-content: center; background-color: #fff1ec; margin-right: 24rpx; }
.thumb-tag { font-size: 24rpx; color: #ff6034; }
.goods-info { flex: 1; flex-direction: column; justify-content: space-between; }
.goods-name { font-size: 30rpx; font-weight: bold; color: #1a1a1a; }
.goods-desc { font-size: 24rpx; color: #9a9a9a; margin-top: 8rpx; }
.bottom-row { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.goods-price { font-size: 32rpx; font-weight: bold; color: #f2270c; }
.add-btn { background-color: #ff6034; border-radius: 28rpx; padding: 10rpx 24rpx; align-items: center; justify-content: center; }
.add-btn-text { font-size: 24rpx; color: #ffffff; }
</style>
