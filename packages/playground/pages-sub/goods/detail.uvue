<template>
	<!-- #ifdef APP -->
	<scroll-view class="container">
	<!-- #endif -->
		<view class="page" v-if="goods !== null">
			<view class="detail-thumb">
				<text class="thumb-tag">{{ tag() }}</text>
			</view>
			<view class="goods-card">
				<text class="goods-name">{{ name() }}</text>
				<text class="goods-price">{{ price() }}</text>
				<text class="goods-desc">{{ desc() }}</text>
			</view>

			<view class="tip-card" v-if="from !== ''">
				<text class="tip-label">来源（params）：</text>
				<text class="tip-value">{{ from }}</text>
			</view>
			<view class="tip-card" v-if="evtBack !== ''">
				<text class="tip-label">EventsPlugin：</text>
				<text class="tip-value">{{ evtBack }}</text>
			</view>

			<view class="action-row">
				<button class="action-btn plain" @click="add">加入购物车</button>
				<button class="action-btn primary" @click="buyNow">立即购买</button>
			</view>
		</view>
	<!-- #ifdef APP -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
// 页面声明宏：编译期由 @meng-xi/unix-router/vite-plugin 剥离，驱动 pages.json 与路由表生成
defineUniPage({
	title: '商品详情',
	name: 'goods-detail'
})
import { useRouter, useRoute, useOpenerEventChannel } from '@/uni_modules/ux-router/utssdk/index.uts'
import { goodsById, formatPrice as fmtPrice, type Goods } from '../../data/goods.uts'
import { addToCart } from '../../store/index.uts'

const router = useRouter()
const route = useRoute()

/** 当前商品（onLoad 时按页面 query 读取；uvue 中路由状态同步晚于页面 onLoad） */
const goods = ref(null as Goods | null)
const from = ref('')
const evtBack = ref('')

/** 本地包装：外部顶层函数在非蒸汽 Kotlin 下以属性对象暴露，需转成本地函数供模板调用 */
function formatPrice(p: number): string { return fmtPrice(p) }

/** 模板访问器：goods 可空，Kotlin 需判空后再取字段，避免对 nullable 接收者调用 */
function tag(): string { return goods.value !== null ? goods.value!.tag : '' }
function name(): string { return goods.value !== null ? goods.value!.name : '' }
function desc(): string { return goods.value !== null ? goods.value!.desc : '' }
function price(): string { return goods.value !== null ? formatPrice(goods.value!.price) : '' }

onLoad((options: UTSJSONObject) => {
	// H5 端 options 缺 key 返回 undefined（非 null），先归一化再判空（跨端空值判断）
	const idStr: string | null = (options['id'] ?? null) as string | null
	if (idStr !== null && idStr.length > 0) {
		goods.value = goodsById(parseInt(idStr, 10))
	} else {
		goods.value = null
	}
})

onShow(() => {
	// 演示 EventsPlugin：打开方携带 events 时回传数据
	const channel = useOpenerEventChannel()
	if (channel !== null) {
		channel.emit('goodsDetailOpened', { id: goods.value !== null ? goods.value.id : 0, name: goods.value !== null ? goods.value.name : '' })
		evtBack.value = '已回传商品信息给打开页'
	} else {
		evtBack.value = ''
	}
	// params 传参来源（列表页可经 params 携带 from）
	const f = route.params.get('from')
	if (f !== null) {
		from.value = f
	} else {
		from.value = ''
	}
})

function add(): void {
	if (goods.value === null) return
	addToCart(goods.value)
	uni.showToast({ title: '已加入购物车', icon: 'none' })
}

function buyNow(): void {
	if (goods.value === null) return
	// 演示 params：把选中商品 id 传给结算页
	router.push({
		name: 'checkout',
		params: new Map([['goodsId', goods.value.id.toString()]])
	})
}
</script>

<style>
.container { flex: 1; background-color: #f5f6f8; }
.page { flex-direction: column; padding: 24rpx; }
.detail-thumb { height: 400rpx; border-radius: 20rpx; align-items: center; justify-content: center; background-color: #fff1ec; margin-bottom: 20rpx; }
.thumb-tag { font-size: 36rpx; color: #ff6034; }
.goods-card { background-color: #ffffff; border-radius: 20rpx; padding: 28rpx; }
.goods-name { font-size: 36rpx; font-weight: bold; color: #1a1a1a; }
.goods-price { font-size: 44rpx; font-weight: bold; color: #f2270c; margin-top: 16rpx; }
.goods-desc { font-size: 26rpx; color: #666666; margin-top: 20rpx; line-height: 1.6; }
.tip-card { flex-direction: row; background-color: #ffffff; border-radius: 20rpx; padding: 24rpx 28rpx; margin-top: 20rpx; }
.tip-label { font-size: 24rpx; color: #9a9a9a; }
.tip-value { font-size: 24rpx; color: #ff6034; }
.action-row { flex-direction: row; margin-top: 40rpx; }
.action-btn { flex: 1; border-radius: 44rpx; align-items: center; padding: 24rpx 0; font-size: 30rpx; }
.action-btn.primary { background-color: #ff6034; color: #ffffff; margin-left: 20rpx; }
.action-btn.plain { background-color: #ffffff; color: #ff6034; }
</style>
