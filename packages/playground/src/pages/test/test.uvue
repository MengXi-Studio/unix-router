<template>
	<view class="page">
		<text class="title">功能自检</text>
		<text class="desc">程序化断言核心逻辑，输出 PASS/FAIL，作为无 vitest 的回归载体。</text>
		<button class="btn" type="primary" @click="runTests">运行自检</button>
		<view class="result">
			<text v-for="line in lines" :key="line.id" class="line">{{ line.text }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
import { NavigationFailure, RouterError, isNavigationFailure, useRouter } from '@meng-xi/unix-router'
import { RouterErrorCode } from '@meng-xi/unix-router'

const router = useRouter()

interface TestLine {
	id: number
	text: string
}

let seq = 0
const lines = ref<TestLine[]>([])

const log = (pass: boolean, msg: string) => {
	seq = seq + 1
	lines.value.push({ id: seq, text: (pass ? '[PASS] ' : '[FAIL] ') + msg })
}

/** 运行全部断言 */
const runTests = () => {
	seq = 0
	lines.value = []

	// 1. 路由表与 hasRoute
	try {
		const routes = router.getRoutes()
		log(routes.length >= 7, `getRoutes() 返回 ${routes.length} 条路由`)
		log(router.hasRoute('params'), 'hasRoute("params") = true')
	} catch (e) {
		log(false, `路由表读取异常: ${(e as Error).message}`)
	}

	// 2. 字符串路径解析 + 查询
	try {
		const loc = router.resolve('/pages/params/params?keyword=hi&from=test')
		log(loc.path === '/pages/params/params', `resolve 字符串路径 → ${loc.path}`)
		log(loc.query.get('keyword') === 'hi', `resolve 查询 keyword=%E9%94%99? 实际=${loc.query.get('keyword')}`)
	} catch (e) {
		log(false, `resolve 字符串解析异常: ${(e as Error).message}`)
	}

	// 3. 命名路由解析
	try {
		const byName = router.resolve({ name: 'guards' })
		log(byName.path === '/pages/guards/guards', `resolve({name}) → ${byName.path}`)
	} catch (e) {
		log(false, `resolve 命名解析异常: ${(e as Error).message}`)
	}

	// 4. 对象路径 + params
	try {
		const withParams = router.resolve({
			path: '/pages/params/params',
			params: new Map([['k', '1']])
		})
		log(withParams.params.get('k') === '1', `resolve 对象带 params → params.k=${withParams.params.get('k')}`)
	} catch (e) {
		log(false, `resolve 对象解析异常: ${(e as Error).message}`)
	}

	// 5. 严格模式下未知命名路由抛 ROUTE_NOT_FOUND
	let throwsNotFound = false
	try {
		router.resolve({ name: 'notExistent' })
	} catch (e) {
		throwsNotFound = e instanceof RouterError && (e as RouterError).code === RouterErrorCode.ROUTE_NOT_FOUND
	}
	log(throwsNotFound, '严格模式解析未知命名路由抛 ROUTE_NOT_FOUND')

	// 6. 错误体系：isNavigationFailure 收窄
	try {
		const failure = new NavigationFailure(RouterErrorCode.DUPLICATED, 'dup', router.currentRoute, router.currentRoute)
		const detected = isNavigationFailure(failure, RouterErrorCode.DUPLICATED)
		log(detected === true, 'isNavigationFailure 识别 NavigationFailure(DUPLICATED)=true')
		const notFailure = new Error('普通错误')
		log(isNavigationFailure(notFailure) === false, 'isNavigationFailure 识别普通 Error=false')
	} catch (e) {
		log(false, `错误体系断言异常: ${(e as Error).message}`)
	}

	// 7. meta 读取（index 为 tab）
	const indexRoute = router.resolve({ name: 'index' })
	log(indexRoute.meta && indexRoute.meta.isTab === true, `index.meta.isTab=${indexRoute.meta && indexRoute.meta.isTab}`)
}

</script>

<style scoped>
.page {
	padding: 24rpx;
	flex-direction: column;
}
.title {
	font-size: 40rpx;
	font-weight: bold;
	color: #333333;
}
.desc {
	margin-top: 12rpx;
	font-size: 24rpx;
	color: #666666;
}
.btn {
	margin-top: 24rpx;
}
.result {
	margin-top: 24rpx;
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx;
}
.line {
	display: block;
	font-size: 24rpx;
	color: #333333;
	margin-top: 8rpx;
}
</style>