<template>
	<view class="page">
		<text class="title">导航方式</text>
		<text class="desc">演示 push / replace / relaunch / back 的行为差异</text>
		<button class="btn" type="primary" @click="doPush">push（新开一页）</button>
		<button class="btn" type="warn" @click="doReplace">replace（替换当前页）</button>
		<button class="btn" @click="doRelaunch">relaunch（清栈并打开）</button>
		<button class="btn" @click="doBack">back（返回上一页）</button>
		<button class="btn" @click="doSamePush">push 当前路径（演示重复导航拦截）</button>
	</view>
</template>

<script setup lang="uts">
import { useRouter } from '@meng-xi/unix-router'

const router = useRouter()

const doPush = () => router.push('/pages/about/about')
const doReplace = () => router.replace('/pages/index/index')
const doRelaunch = () => router.relaunch('/pages/about/about')
const doBack = () => router.back()
const doSamePush = async () => {
	try {
		await router.push('/pages/navigation/navigation')
	} catch (e) {
		const err = e as Error
		console.warn('[navigation] 重复导航被拦截: ' + err.message)
		uni.showToast({ title: '重复导航被拦截', icon: 'none' })
	}
}
</script>

<style scoped>
.page {
	padding: 24rpx;
	flex-direction: column;
}
.title {
	font-size: 40rpx;
	font-weight: bold;
	color: #333333;
}
.desc {
	margin-top: 12rpx;
	font-size: 24rpx;
	color: #666666;
}
.btn {
	margin-top: 24rpx;
}
</style>