<template>
	<view class="page">
		<text class="title">关于 unix-router</text>
		<text class="desc">为 uni-app x 提供的、风格对标 vue-router 4 的路由库。</text>
		<text class="desc">当前：{{ route.fullPath }}</text>
		<button v-if="canBack" class="btn" @click="goBack">返回上一页（back）</button>
		<button class="btn" type="primary" @click="goHome">回到首页</button>
		<RouterLink to="/pages/params/params">
			<view class="link-box">去参数页</view>
		</RouterLink>
	</view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
import { useRouter, useRoute } from '@meng-xi/unix-router'

const router = useRouter()
const route = useRoute()

const canBack = computed(() => router.currentRoute.path !== '/pages/index/index')

const goBack = () => {
	router.back()
}
const goHome = () => {
	router.relaunch('/pages/index/index')
}
</script>

<style scoped>
.page {
	padding: 24rpx;
	flex-direction: column;
}
.title {
	font-size: 40rpx;
	font-weight: bold;
	color: #333333;
}
.desc {
	margin-top: 12rpx;
	font-size: 24rpx;
	color: #666666;
}
.btn {
	margin-top: 24rpx;
}
.link-box {
	margin-top: 24rpx;
	padding: 20rpx;
	background-color: #f0f4ff;
	border-radius: 12rpx;
	color: #007aff;
	text-align: center;
}
</style>